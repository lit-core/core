{
  "name": "@lit-core/core",
  "version": "0.1.0",
  "private": true,
  "description": "Ahead-of-time (AOT) compiler and bundler optimization toolchain for Lit and Web Components",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/lit-core/core#readme",
  "bugs": {
    "url": "https://github.com/lit-core/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lit-core/core"
  },
  "keywords": [
    "lit",
    "web-components",
    "vite",
    "compiler",
    "css-fuse",
    "constructable-stylesheets",
    "aot",
    "bundler"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "test": "turbo run test",
    "test:rust": "for pkg in css-fuse props-lower css-minifier html-minifier html-fuse native event-hoist memoize elem-proxy dom-paths dirty-mask; do cargo test --manifest-path packages/$pkg/Cargo.toml; done",
    "typecheck": "turbo run typecheck",
    "benchmark": "pnpm --filter @lit-core/benchmarks run benchmark",
    "benchmark:webawesome": "pnpm --filter @lit-core/benchmarks run benchmark:webawesome",
    "benchmark:momentum": "pnpm --filter @lit-core/benchmarks run benchmark:momentum",
    "benchmark:elem-proxy": "pnpm --filter @lit-core/benchmarks run benchmark:elem-proxy",
    "benchmark:event-hoist": "pnpm --filter @lit-core/benchmarks run benchmark:event-hoist",
    "benchmark:dirty-mask": "pnpm --filter @lit-core/benchmarks run benchmark:dirty-mask",
    "benchmark:dom-paths": "pnpm --filter @lit-core/benchmarks run benchmark:dom-paths",
    "benchmark:memoize": "pnpm --filter @lit-core/benchmarks run benchmark:memoize",
    "benchmark:native": "pnpm --filter @lit-core/benchmarks run benchmark:native",
    "benchmark:resumable": "pnpm --filter @lit-core/benchmarks run benchmark:resumable",
    "viewer:dev": "pnpm --filter @lit-core/benchmarks run viewer:dev",
    "viewer:build": "pnpm --filter @lit-core/benchmarks run viewer:build",
    "viewer:preview": "pnpm --filter @lit-core/benchmarks run viewer:preview",
    "showcase:dev": "pnpm --filter @lit-core/showcase run dev",
    "showcase:build": "pnpm --filter @lit-core/showcase run build",
    "showcase:preview": "pnpm --filter @lit-core/showcase run preview",
    "test:showcase": "pnpm --filter @lit-core/tests run test:showcase",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@momentum-design/components": "^0.139.9",
    "@types/webpack": "^5.28.5",
    "playwright": "^1.63.0",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "webpack": "^5.111.1"
  },
  "packageManager": "pnpm@11.11.0",
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0"
  }
}
