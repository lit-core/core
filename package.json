{
  "name": "@lit-core/core",
  "version": "0.1.0",
  "private": true,
  "description": "Ahead-of-time (AOT) compiler and bundler optimization toolchain for Lit and Web Components",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/lit-core/core#readme",
  "bugs": {
    "url": "https://github.com/lit-core/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lit-core/core"
  },
  "keywords": [
    "lit",
    "web-components",
    "vite",
    "compiler",
    "css-fuse",
    "constructable-stylesheets",
    "aot",
    "bundler"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "benchmark": "pnpm --filter @lit-core/benchmarks run benchmark",
    "benchmark:webawesome": "pnpm --filter @lit-core/benchmarks run benchmark:webawesome",
    "benchmark:momentum": "pnpm --filter @lit-core/benchmarks run benchmark:momentum",
    "benchmark:event-hoist": "pnpm --filter @lit-core/benchmarks run benchmark:event-hoist",
    "benchmark:resumable": "pnpm --filter @lit-core/benchmarks run benchmark:resumable",
    "benchmark:markdown": "pnpm --filter @lit-core/benchmarks run benchmark:markdown",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@momentum-design/components": "^0.139.9",
    "@types/webpack": "^5.28.5",
    "playwright": "^1.63.0",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "webpack": "^5.111.1"
  },
  "packageManager": "pnpm@11.11.0",
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0"
  }
}
