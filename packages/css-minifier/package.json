{
  "name": "@lit-core/css-minifier",
  "version": "0.1.0",
  "description": "Embedded CSS template minification for Lit via OXC and Lightning CSS",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src/index.js",
    "src/index.d.ts",
    "*.node"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lit-core/core",
    "directory": "packages/css-minifier"
  },
  "homepage": "https://github.com/lit-core/core/tree/main/packages/css-minifier#readme",
  "bugs": {
    "url": "https://github.com/lit-core/core/issues"
  },
  "keywords": [
    "lit",
    "web-components",
    "css",
    "minifier",
    "lightningcss",
    "oxc",
    "template-literals"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "napi": {
    "binaryName": "css-minifier",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-native.mjs css-minifier --release",
    "build:debug": "node ../../scripts/build-native.mjs css-minifier",
    "test": "node tests/minifier.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8"
  }
}
