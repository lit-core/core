{
  "name": "@lit-core/html-aot",
  "version": "0.1.0",
  "description": "Ahead-of-time template compiler for Lit and Web Components",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/index.js",
    "src/index.d.ts",
    "lib/index.js",
    "lib/index.d.ts",
    "*.node"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lit-core/core",
    "directory": "packages/html-aot"
  },
  "keywords": [
    "lit",
    "web-components",
    "html-aot",
    "compiler",
    "oxc",
    "templates"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "napi": {
    "binaryName": "html-aot",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-native.mjs html-aot --release",
    "build:debug": "node ../../scripts/build-native.mjs html-aot",
    "test": "vitest run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.6",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
