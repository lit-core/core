  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@parse5/tools": "^0.3.0",
    "lit-html": "^3.3.3",
    "parse5": "^7.3.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "vitest": "^5.0.2"
  }
}
