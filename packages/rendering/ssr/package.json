{
  "name": "@lit-core/ssr",
  "version": "0.1.0",
  "description": "Universal server-side rendering engine for Lit and Web Components emitting clean Declarative Shadow DOM",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js",
      "default": "./dist/environment.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js",
      "default": "./dist/stream.js"
    },
    "./slot": {
      "types": "./dist/slot.d.ts",
      "import": "./dist/slot.js",
      "default": "./dist/slot.js"
    },
    "./compiler-bridge": {
      "types": "./dist/compiler-bridge.d.ts",
      "import": "./dist/compiler-bridge.js",
      "default": "./dist/compiler-bridge.js"
    }
  },
  "files": [
    "dist",
    "src",
    "wasm",
    "*.node",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "node ../../../scripts/build-native.mjs ssr --release --tsc",
    "build:wasm": "cargo build --profile wasm-release --target wasm32-unknown-unknown -p ssr && wasm-bindgen --target web --out-dir wasm ../../../target/wasm32-unknown-unknown/wasm-release/ssr.wasm && wasm-opt -Oz --strip-debug --strip-dwarf --strip-producers --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext --enable-mutable-globals --enable-reference-types -o wasm/ssr_bg.wasm wasm/ssr_bg.wasm",
    "build:debug": "node ../../../scripts/build-native.mjs ssr --tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "lit",
    "ssr",
    "server-side-rendering",
    "declarative-shadow-dom",
    "dsd",
    "web-components",
    "edge",
    "streaming",
    "cloudflare-workers",
    "fastly-compute"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lit-core/core",
    "directory": "packages/rendering/ssr"
  },
  "dependencies": {
    "@lit-core/resumable": "workspace:*",
    "css-select": "^7.0.0"
  },
  "devDependencies": {
    "@lit-core/html-aot": "workspace:*",
    "@lit-core/test-kit": "workspace:*",
    "@types/node": "^26.6.6",
    "lit": "^3.3.3",
    "miniflare": "^4.20260730.0",
    "playwright": "~1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "workerd": "^1.20261101.1"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  }
}
