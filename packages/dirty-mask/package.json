{
  "name": "@lit-core/dirty-mask",
  "version": "0.1.0",
  "description": "Ahead-of-time property-to-part dependency bitmasking compiler pass and bundler optimization for Lit and Web Components",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/index.js",
    "src/index.d.ts",
    "*.node"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lit-core/core",
    "directory": "packages/dirty-mask"
  },
  "keywords": [
    "lit",
    "web-components",
    "dirty-mask",
    "bitmask",
    "aot",
    "oxc",
    "performance"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "napi": {
    "binaryName": "dirty-mask",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-native.mjs dirty-mask --release",
    "build:debug": "node ../../scripts/build-native.mjs dirty-mask",
    "test": "vitest run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "vitest": "^5.0.3"
  }
}
