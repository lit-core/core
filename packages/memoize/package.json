{
  "name": "@lit-core/memoize",
  "version": "0.1.0",
  "description": "Ahead-of-time reactive expression auto-memoization compiler pass and bundler optimization for Lit and Web Components",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src/index.js",
    "src/index.d.ts",
    "src/js-fallback.js",
    "*.node"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lit-core/core",
    "directory": "packages/memoize"
  },
  "keywords": [
    "lit",
    "web-components",
    "memoize",
    "react-compiler",
    "aot",
    "oxc",
    "performance"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "napi": {
    "binaryName": "memoize",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "cargo build --release && cp target/release/libmemoize.dylib memoize.darwin-arm64.node 2>/dev/null || true",
    "build:debug": "cargo build && cp target/debug/libmemoize.dylib memoize.darwin-arm64.node 2>/dev/null || true",
    "test": "vitest run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5",
    "vitest": "^5.0.2"
  }
}
