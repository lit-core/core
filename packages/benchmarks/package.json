{
  "name": "@lit-core/benchmarks",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-suite bundle size and optimization benchmark framework for @lit-core Vite bundler",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./suites": "./src/suites/index.js",
    "./runner": "./src/runner.js",
    "./tools": "./src/tools/index.js",
    "./table": "./src/table.js",
    "./runtime": "./src/runtime.js",
    "./resumable": "./src/resumable-bench.js",
    "./native": "./src/native-bench.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build viewer --base=./",
    "benchmark": "node src/index.js",
    "benchmark:carbon": "node src/index.js --suite=carbon",
    "benchmark:spectrum": "node src/index.js --suite=spectrum",
    "benchmark:webawesome": "node src/index.js --suite=webawesome",
    "benchmark:material": "node src/index.js --suite=material",
    "benchmark:momentum": "node src/index.js --suite=momentum",
    "benchmark:all": "node src/index.js --suite=all",
    "benchmark:scenarios": "node src/index.js --scenarios",
    "benchmark:scenario:grid": "node src/index.js --scenario=data-grid",
    "benchmark:scenario:form": "node src/index.js --scenario=interactive-form",
    "benchmark:scenario:ssr": "node src/index.js --scenario=ssr-dashboard",
    "benchmark:scenario:feed": "node src/index.js --scenario=dynamic-feed",
    "benchmark:scenario:selective": "node src/index.js --scenario=selective-app",
    "benchmark:scenario:bundle": "node src/index.js --scenario=bundle",
    "benchmark:elem-proxy": "node src/elem-proxy-bench.js",
    "benchmark:event-hoist": "node src/event-hoist-bench.js",
    "benchmark:dirty-mask": "node src/dirty-mask-bench.js",
    "benchmark:directives": "node src/directives-bench.js",
    "benchmark:dom-paths": "node src/dom-paths-bench.js",
    "benchmark:memoize": "node src/memoize-bench.js",
    "benchmark:native": "node src/native-bench.js",
    "benchmark:resumable": "node src/resumable-bench.js",
    "benchmark:tag-shake": "node src/tag-shake-bench.js",
    "benchmark:json": "node src/index.js --format=json",
    "benchmark:compare": "node src/compare.js",
    "viewer:dev": "vite viewer",
    "viewer:build": "vite build viewer --base=./ && cp -r results viewer/dist/results && cp -r ../showcase/dist viewer/dist/showcase",
    "viewer:preview": "vite preview viewer",
    "test": "tsc --noEmit && vitest run tests",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lit-core/core",
    "directory": "packages/benchmarks"
  },
  "homepage": "https://github.com/lit-core/core/tree/main/packages/benchmarks#readme",
  "bugs": {
    "url": "https://github.com/lit-core/core/issues"
  },
  "dependencies": {
    "@lit-core/css-fuse": "workspace:*",
    "@lit-core/css-minifier": "workspace:*",
    "@lit-core/directives": "workspace:*",
    "@lit-core/dirty-mask": "workspace:*",
    "@lit-core/dom-paths": "workspace:*",
    "@lit-core/elem-proxy": "workspace:*",
    "@lit-core/event-hoist": "workspace:*",
    "@lit-core/html-aot": "workspace:*",
    "@lit-core/html-fuse": "workspace:*",
    "@lit-core/html-minifier": "workspace:*",
    "@lit-core/memoize": "workspace:*",
    "@lit-core/props-lower": "workspace:*",
    "@lit-core/resumable": "workspace:*",
    "@lit-core/tag-shake": "workspace:*",
    "@lit-core/test-kit": "workspace:*",
    "@lit-core/vite-plugin": "workspace:*",
    "lucide-react": "^1.51.0"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@carbon/web-components": "^2.64.0",
    "@material/web": "^2.5.0",
    "@momentum-design/components": "^0.140.1",
    "@spectrum-web-components/bundle": "^1.12.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lit": "^3.3.3",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
