{
  "name": "@lit-core/benchmarks",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-suite bundle size and optimization benchmark framework for @lit-core Vite bundler",
  "type": "module",
  "main": "src/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "benchmark": "node src/index.js",
    "benchmark:webawesome": "node src/index.js --suite=webawesome",
    "benchmark:lit-ds": "node src/index.js --suite=lit-ds",
    "benchmark:all": "node src/index.js --suite=all",
    "benchmark:markdown": "node src/index.js --format=markdown",
    "benchmark:json": "node src/index.js --format=json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@lit-core/css-fuse": "workspace:*",
    "@lit-core/css-minifier": "workspace:*",
    "@lit-core/html-minifier": "workspace:*",
    "@lit-core/props-lower": "workspace:*",
    "@lit-core/vite-plugin": "workspace:*",
    "lit": "^3.3.3",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@carbon/web-components": "^2.64.0",
    "@material/web": "^2.5.0",
    "@spectrum-web-components/bundle": "^1.12.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
