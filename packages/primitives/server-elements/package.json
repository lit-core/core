{
  "name": "@lit-core/server-elements",
  "version": "0.1.0",
  "description": "Authoring primitives, decorators, and context types for Lit server elements",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "default": "./dist/edge.js"
    },
    "./executor": {
      "types": "./dist/executor.d.ts",
      "import": "./dist/executor.js",
      "default": "./dist/executor.js"
    },
    "./action-endpoint": {
      "types": "./dist/action-endpoint.d.ts",
      "import": "./dist/action-endpoint.js",
      "default": "./dist/action-endpoint.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js",
      "default": "./dist/crypto.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "lit",
    "server-elements",
    "web-components",
    "edge",
    "cloudflare-workers",
    "wintercg",
    "decorators",
    "dsd",
    "ssr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lit-core/core",
    "directory": "packages/primitives/server-elements"
  },
  "dependencies": {
    "@lit-core/ssr": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "lit": "^3.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  }
}
