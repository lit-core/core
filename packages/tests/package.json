{
  "name": "@lit-core/tests",
  "version": "0.1.0",
  "private": true,
  "description": "Comprehensive multi-framework Playwright test suite for all @lit-core compiler and bundler features",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:carbon": "vitest run carbon",
    "test:spectrum": "vitest run spectrum",
    "test:webawesome": "vitest run webawesome",
    "test:material": "vitest run material",
    "test:momentum": "vitest run momentum",
    "test:plugins": "vitest run plugins",
    "typecheck": "tsc --noEmit"
