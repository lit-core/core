{
  "name": "@lit-core/showcase",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-framework component showcase with isolated compiler passes and visual inspector",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./canonical-registry": {
      "import": "./src/canonical-registry.ts",
      "types": "./src/canonical-registry.ts"
    },
    "./features": {
      "import": "./src/features.ts",
      "types": "./src/features.ts"
    },
    "./ui": {
      "import": "./src/ShowcaseViewer.tsx",
      "types": "./src/ShowcaseViewer.tsx"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node build.js",
    "preview": "vite preview --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@carbon/styles": "^1.118.0",
    "@carbon/web-components": "^2.66.0",
    "@lit-core/css-fuse": "workspace:*",
    "@lit-core/css-minifier": "workspace:*",
    "@lit-core/dirty-mask": "workspace:*",
    "@lit-core/dom-paths": "workspace:*",
    "@lit-core/elem-proxy": "workspace:*",
    "@lit-core/event-hoist": "workspace:*",
    "@lit-core/html-aot": "workspace:*",
    "@lit-core/html-fuse": "workspace:*",
    "@lit-core/html-minifier": "workspace:*",
    "@lit-core/memoize": "workspace:*",
    "@lit-core/native": "workspace:*",
    "@lit-core/props-lower": "workspace:*",
    "@lit-core/resumable": "workspace:*",
    "@lit-core/ssr": "workspace:*",
    "@lit-core/vite-plugin": "workspace:*",
    "@material/web": "^2.5.0",
    "@momentum-design/components": "^0.142.5",
    "@spectrum-web-components/action-button": "^1.12.5",
    "@spectrum-web-components/action-group": "^1.12.5",
    "@spectrum-web-components/badge": "^1.12.5",
    "@spectrum-web-components/bundle": "^1.12.5",
    "@spectrum-web-components/button": "^1.12.5",
    "@spectrum-web-components/card": "^1.12.5",
    "@spectrum-web-components/checkbox": "^1.12.5",
    "@spectrum-web-components/dialog": "^1.12.5",
    "@spectrum-web-components/divider": "^1.12.5",
    "@spectrum-web-components/icon": "^1.12.5",
    "@spectrum-web-components/menu": "^1.12.5",
    "@spectrum-web-components/picker": "^1.12.5",
    "@spectrum-web-components/popover": "^1.12.5",
    "@spectrum-web-components/progress-bar": "^1.12.5",
    "@spectrum-web-components/progress-circle": "^1.12.5",
    "@spectrum-web-components/radio": "^1.12.5",
    "@spectrum-web-components/sidenav": "^1.12.5",
    "@spectrum-web-components/slider": "^1.12.5",
    "@spectrum-web-components/switch": "^1.12.5",
    "@spectrum-web-components/tabs": "^1.12.5",
    "@spectrum-web-components/textfield": "^1.12.5",
    "@spectrum-web-components/theme": "^1.12.5",
    "lit": "^3.3.3",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
