{
  "name": "@lit-core/css-fuse",
  "version": "0.1.0",
  "description": "AOT constructable stylesheet deduplication engine for web components",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "bin",
    "*.node"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lit-core/core",
    "directory": "packages/css-fuse"
  },
  "homepage": "https://github.com/lit-core/core/tree/main/packages/css-fuse#readme",
  "bugs": {
    "url": "https://github.com/lit-core/core/issues"
  },
  "keywords": [
    "lit",
    "web-components",
    "css",
    "dedup",
    "constructable-stylesheets",
    "ast",
    "oxc",
    "lightningcss"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "napi": {
    "binaryName": "css-fuse",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "bin": {
    "css-fuse": "bin/css-fuse.js",
    "css-fuse-bin": "bin/css-fuse-bin"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "node ../../scripts/build-native.mjs css-fuse --release",
    "build:debug": "node ../../scripts/build-native.mjs css-fuse",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version",
    "test": "node tests/fuse.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.6"
  }
}
