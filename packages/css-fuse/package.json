{
  "name": "@lit-core/css-fuse",
  "version": "0.1.0",
  "description": "AOT constructable stylesheet deduplication engine for web components",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "napi": {
    "binaryName": "css-fuse",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "bin": {
    "css-fuse": "bin/css-fuse.js",
    "css-fuse-bin": "bin/css-fuse-bin"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "cargo build --release --bin css-fuse-bin && cp target/release/css-fuse-bin bin/css-fuse-bin",
    "build:debug": "cargo build --bin css-fuse-bin && cp target/debug/css-fuse-bin bin/css-fuse-bin",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version",
    "test": "node src/test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5"
  },
  "packageManager": "pnpm@11.11.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lit-core/core",
    "directory": "packages/css-fuse"
  }
}
